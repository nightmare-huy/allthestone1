{
	chapter.0000000000000001.title: "Welcome",
	chapter.0000000000000001.chapter_subtitle: [
		"Начни здесь",
		"Ты в камне. Это задумано."
	],
	quest.1000000000000001.title: "All The Stone 1",
	quest.1000000000000001.quest_subtitle: "Ты заперт в камне. Это нормально.",
	quest.1000000000000001.quest_desc: [
		"Вокруг тебя нет ни неба, ни деревьев - только сплошной камень от бедрока до бедрока.",
		"",
		"&6Как начать:&r",
		"1. У тебя в инвентаре уже есть &eдеревянный молот&r и &eнить-сито&r.",
		"2. ПКМ молотом по камню - получишь булыжник, потом снова молотом по булыжнику - гравий.",
		"3. Гравий молотом - песок, песок молотом - &eкаменная пыль&r.",
		"4. Ставь &eсито&r и просеивай гравий/песок/пыль, чтобы добыть ресурсы.",
		"",
		"&7Подсказка:&r shift + ПКМ пустой рукой по камню даёт &eкаменную гальку&r с шансом 50%. 4 гальки = булыжник.",
		"",
		"&bОткрой вкладку Stone Age&r - там весь путь от первой гальки до первой машины."
	],
	task.2000000000000001.title: "Прочитал вступление",
	quest.1000000000000002.title: "Правила выживания",
	quest.1000000000000002.quest_subtitle: "Что делать, если что-то пошло не так",
	quest.1000000000000002.quest_desc: [
		"&cТы в камне:&r если ты каким-то образом оказался внутри камня - подожди секунду, скрипт вытащит тебя обратно в стартовую комнату.",
		"",
		"&eСмерть:&r keepInventory включён, вещи не теряются.",
		"",
		"&eСпавн:&r стартовая комната 5x5x5 на координатах 0 64 0 в измерении &fallthestone1:stone_world&r.",
		"",
		"&eЕсли ты умер и оказался не там:&r перезайди в мир - тебя телепортирует обратно.",
		"",
		"&eКвесты:&r FTB Quests. Награды забирай вручную, они не выдаются автоматически."
	],
	quest.1000000000000003.title: "Что дальше",
	quest.1000000000000003.quest_subtitle: "Карта прогрессии",
	quest.1000000000000003.quest_desc: [
		"Дальше две дороги, и обе ведут в &eStone Age&r:",
		"",
		"&6Ресурсы:&r сито -> галька/песок/пыль -> руды, семена, глина.",
		"&6Техника:&r бочка + вода + лава -> обсидиан -> первая энергия -> Mekanism.",
		"",
		"Дерево в этом мире не растёт само: получи первый саженец в квесте &eПервое дерево&r.",
		"",
		"&7Совет:&r FTB Ultimine (по умолчанию зажми клавишу ~) копает жилы, но камень - это не жила. Используй молот."
	],
	task.2000000000000003.title: "Понял план",

	chapter.0000000000000002.title: "Stone Age",
	chapter.0000000000000002.chapter_subtitle: [
		"От первой гальки до первой энергии"
	],
	quest.1100000000000001.title: "Первая галька",
	quest.1100000000000001.quest_subtitle: "Shift + ПКМ пустой рукой по камню",
	quest.1100000000000001.quest_desc: [
		"Шанс &e50%&r получить &eкаменную гальку&r при ударе пустой рукой с зажатым shift по камню или булыжнику.",
		"",
		"&64 гальки = 1 булыжник&r (рецепт 2x2).",
		"",
		"Это твой самый первый ресурс - без дерева, без инструментов."
	],
	quest.1100000000000002.title: "Верстак из камня",
	quest.1100000000000002.quest_subtitle: "4 булыжника + 4 гальки",
	quest.1100000000000002.quest_desc: [
		"В этом мире нет досок, поэтому обычный верстак недоступен.",
		"",
		"Крафт: &e2 булыжника сверху, 2 гальки снизу&r (или по рецепту &f4 булыжника + 4 гальки&r в сетке)."
	],
	quest.1100000000000003.title: "Молот",
	quest.1100000000000003.quest_subtitle: "Камень -> булыжник -> гравий -> песок",
	quest.1100000000000003.quest_desc: [
		"Молот - это твой универсальный инструмент дробилки.",
		"",
		"&6Молот по камню&r -> булыжник + галька.",
		"&6Молот по булыжнику&r -> гравий.",
		"&6Молот по гравию&r -> песок.",
		"&6Молот по песку&r -> &eкаменная пыль&r (exdeorum:dust).",
		"",
		"Найди в квесте рецепт молота из гальки и палок, если деревянный сломался."
	],
	quest.1100000000000004.title: "Сито",
	quest.1100000000000004.quest_subtitle: "Просеивание - основа всего",
	quest.1100000000000004.quest_desc: [
		"Поставь &eсито&r и клади в него материалы, кликая по нему нужным предметом.",
		"",
		"&6Что просеивать:&r",
		"• &eГравий&r -> кремень, кусочки руд, галька.",
		"• &eПесок&r -> кремень, семена кактуса, кристаллы.",
		"• &eПыль&r -> семена травы, семена пшеницы.",
		"",
		"&bСетки (mesh):&r нить -> кремень -> железо -> золото -> алмаз -> незерит. Чем лучше сетка, тем лучше дроп."
	],
	quest.1100000000000005.title: "Первая земля",
	quest.1100000000000005.quest_subtitle: "4 гравия + 4 песка",
	quest.1100000000000005.quest_desc: [
		"Земля нужна для травы, саженцев и фермы.",
		"",
		"&6Крафт:&r 4 гравия + 4 песка (или пыли) в любой форме.",
		"",
		"Потом просеивай землю через &eсито с нитяной сеткой&r - выпадут &eсемена травы&r и &eсемена пшеницы&r."
	],
	quest.1100000000000006.title: "Первое дерево",
	quest.1100000000000006.quest_subtitle: "Земля + костная мука + галька",
	quest.1100000000000006.quest_desc: [
		"Настоящее дерево в каменном мире не вырастет само, поэтому у нас есть крафт саженца.",
		"",
		"&6Крафт саженца:&r земля + 4 костной муки (или пыли) + галька.",
		"",
		"Костную муку можно сделать из &e3 каменной пыли&r.",
		"",
		"Посади саженец на землю - и у тебя появятся доски, палки и деревянные инструменты."
	],
	quest.1100000000000007.title: "Бочка и вода",
	quest.1100000000000007.quest_subtitle: "Первый источник воды",
	quest.1100000000000007.quest_desc: [
		"Бочка + дождь = вода. В каменном мире дождя нет, но есть &eтигель&r.",
		"",
		"&6Тигель (crucible):&r положи в него листву/саженцы и подожги снизу - получится вода.",
		"",
		"Если тигель пока недоступен: &eбочка + лёд&r или ведро воды из просеивания.",
		"",
		"Вода нужна для &eобсидиана&r (вода + лава) - а обсидиан открывает портал и первый генератор энергии."
	],
	quest.1100000000000008.title: "Обсидиан",
	quest.1100000000000008.quest_subtitle: "Вода + лава",
	quest.1100000000000008.quest_desc: [
		"Лава получается из &eкаменного тигля&r (crucible над огнём).",
		"",
		"Соедини воду и лаву, чтобы получить &eобсидиан&r.",
		"",
		"Обсидиан - базовый материал для усиленных машин и портала в Нижний мир."
	],
	quest.1100000000000009.title: "Железо",
	quest.1100000000000009.quest_subtitle: "Из гравия и песка",
	quest.1100000000000009.quest_desc: [
		"В каменном мире железо не копают - его &eпросеивают&r.",
		"",
		"&6Гравий через сетку из кремня/железа&r -> кусочки железной руды (exdeorum:iron_ore_chunk).",
		"Дальше кусочки переплавляются в железные слитки.",
		"",
		"Железо - это сетка из железа, ведро, инструменты и первые машины."
	],
	quest.1100000000000010.title: "Первая энергия",
	quest.1100000000000010.quest_subtitle: "Конец Stone Age",
	quest.1100000000000010.quest_desc: [
		"Железо есть - пора собрать первый генератор.",
		"",
		"&6Mekanism:&r Heat Generator - самый дешёвый генератор.",
		"",
		"Дальше открывается весь тех-прогресс: Mekanism, Powah, AE2, Industrial Foregoing.",
		"",
		"&bStone Age пройден.&r Дальше - на свой вкус: автоматизация, ресурсы, магия."
	]
}
